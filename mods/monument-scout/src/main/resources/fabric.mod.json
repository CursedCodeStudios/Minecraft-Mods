{
  "schemaVersion": 1,
  "id": "monumentscout",
  "version": "${version}",
  "name": "Monument Scout",
  "description": "Tracks ocean monument sponges and current elder guardian sightings with Xaero waypoints.",
  "environment": "client",
  "entrypoints": { "client": ["dev.monumentscout.MonumentScout"] },
  "license": "MIT",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": { "xaerominimap": "*", "xaeroworldmap": "*" }
}
